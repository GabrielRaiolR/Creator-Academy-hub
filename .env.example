# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# PostgreSQL (Neon). Use a connection string "pooled" (host com -pooler) em produção.
# Ex.: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Better Auth
# Gere com: npx @better-auth/cli secret   (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL pública da aplicação (sem barra no final). Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (store PRIVADO). Criado em Vercel > Storage > Blob.
BLOB_READ_WRITE_TOKEN=

# Tamanho máximo de upload de PDF, em megabytes.
MAX_UPLOAD_SIZE_MB=20

# Usados apenas pelos scripts `npm run db:seed` e `npm run admin:create`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Senha dos 2 alunos de demonstração criados pelo seed (padrão: aluno-demo-123).
SEED_STUDENT_PASSWORD=
